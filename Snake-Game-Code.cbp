<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Snake-Game-Code" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/Snake-Game-Code" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="`pkg-config --libs raylib` -lGL -lm -lpthread -ldl -lrt -lX11" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/Snake-Game-Code" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add directory="include" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
		</Compiler>
		<Unit filename="include/Apple.h" />
		<Unit filename="include/CheckCollisionSnake.hpp" />
		<Unit filename="include/Grid.hpp" />
		<Unit filename="include/Node.h" />
		<Unit filename="include/ResetGame.hpp" />
		<Unit filename="include/Snake.h" />
		<Unit filename="include/VetApples.h" />
		<Unit filename="main.cpp" />
		<Unit filename="resources/gameOver.png" />
		<Unit filename="src/Apple.cpp" />
		<Unit filename="src/CheckCollisionSnake.cpp" />
		<Unit filename="src/Grid.cpp" />
		<Unit filename="src/Node.cpp" />
		<Unit filename="src/ResetGame.cpp" />
		<Unit filename="src/Snake.cpp" />
		<Unit filename="src/VetApples.cpp" />
		<Extensions />
	</Project>
</CodeBlocks_project_file>
